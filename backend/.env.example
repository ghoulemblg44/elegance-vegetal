PORT=5000
MONGODB_URI=mongodb://localhost:27017/elegance-vegetal
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Delivery pricing (all optional; defaults shown) -------------------------
# Weight surcharge: DELIVERY_WEIGHT_STEP_FEE DA for every started
# DELIVERY_WEIGHT_STEP_KG kg above DELIVERY_WEIGHT_FREE_KG kg.
# DELIVERY_WEIGHT_FREE_KG=5
# DELIVERY_WEIGHT_STEP_KG=5
# DELIVERY_WEIGHT_STEP_FEE=50
# Refuse orders containing a product with no recorded weight (default: accept and flag in Admin).
# DELIVERY_REQUIRE_PRODUCT_WEIGHTS=false
